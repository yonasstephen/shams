{
  "manifest_version": 3,
  "name": "Shams Season Assistant",
  "version": "0.1.0",
  "description": "Matchup projections, games remaining and waiver adds from the Shams engine, inline on Yahoo fantasy basketball.",

  "permissions": ["storage"],

  "host_permissions": ["https://raw.githubusercontent.com/*"],

  "action": {
    "default_title": "Shams Season Assistant",
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://basketball.fantasysports.yahoo.com/nba/*"],
      "js": ["content-team.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://basketball.fantasysports.yahoo.com/nba/*/matchup*"],
      "js": ["content-matchup.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://basketball.fantasysports.yahoo.com/nba/*/trade_hub*"],
      "js": ["content-tradehub.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://basketball.fantasysports.yahoo.com/nba/*/transactions*"],
      "js": ["content-transactions.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
